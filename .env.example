# Copy to .env.local and fill in. Never commit .env.local or any real value.

# --- Database -------------------------------------------------------------
# Leave empty for local dev: an embedded PostgreSQL (PGlite) is created in .data/.
# For Supabase/hosted Postgres use the connection string (pooler URL is fine).
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS.
DATABASE_SSL=

# --- Proof signing (Ed25519) ----------------------------------------------
# Required in production. Generate with: npm run keys:generate
# In development a key is auto-created in .data/dev-signing-key.pem if unset.
CW_SIGNING_PRIVATE_KEY=

# --- Demo accounts ----------------------------------------------------------
# Password for buyer@demo.cartwitness.test / merchant@demo.cartwitness.test (min 10 chars).
# If empty, `npm run db:seed` generates one and prints it once.
SEED_DEMO_PASSWORD=

# --- PayPal sandbox (Phase 3 — not used yet) -------------------------------
# From developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI suggestions (Phase 2 — optional) ----------------------------------
# AI only pre-fills fields for the buyer to review; it is never trusted for enforcement.
AI_PROVIDER=
AI_API_KEY=
