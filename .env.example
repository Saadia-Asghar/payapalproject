# Copy to .env.local and fill in. Never commit .env.local or any real value.

# --- Database -------------------------------------------------------------
# Leave empty for local dev: an embedded PostgreSQL (PGlite) is created in .data/.
# For Supabase/hosted Postgres use the connection string (pooler URL is fine).
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS.
DATABASE_SSL=
# Production refuses the embedded database unless this is "1" (only for a local `next start` demo).
CW_ALLOW_EMBEDDED_DB=

# --- Proof signing (Ed25519) ----------------------------------------------
# Required in production. Generate with: npm run keys:generate
# In development a key is auto-created in .data/dev-signing-key.pem if unset.
CW_SIGNING_PRIVATE_KEY=

# --- Demo accounts ----------------------------------------------------------
# Password for buyer@demo.cartwitness.test / merchant@demo.cartwitness.test (min 10 chars).
# If empty, `npm run db:seed` generates one and prints it once.
SEED_DEMO_PASSWORD=

# --- PayPal sandbox (Phase 3 — not used yet) -------------------------------
# From developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI form suggestions (optional) ----------------------------------------
# Claude pre-fills Permission Form fields from the buyer's own words; the buyer reviews every
# field and the server re-validates. Without a key a rule-based parser is used instead.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
CW_AI_MODEL=

# --- Demo access and passkeys ---
# One-click "Try as buyer / Try as merchant" on /login (on by default; set to off to hide).
CW_DEMO_LOGIN=
# Passkey relying-party ID. Defaults to the site's hostname; passkeys work on the domain they were created on.
CW_WEBAUTHN_RP_ID=
