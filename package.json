{
  "name": "cartwitness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "keys:generate": "node scripts/generate-signing-key.ts",
    "smoke": "node scripts/smoke.ts",
    "vercel-build": "node scripts/deploy-prepare.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@electric-sql/pglite": "^0.5.14",
    "next": "16.4.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
